FUNCTION FC 160 : VOID
TITLE =HMI Process
//DRAFT -- not verified against the real HMI DB10 layout or the
//SIMATIC Manager project. Syntax-check and compile here before
//downloading. See FC160_design.md in this folder for rationale and
//the open question about whether the TP177A reads HMI DB10's raw
//addresses directly or a separate HMI region like the one assumed
//below.
//
//DB10's symbol-table name is "HMI DB10" -- STL addressing below still
//uses the absolute DB10.DBx form regardless of that symbolic name.
//
//Call from OB35 (time-driven, ~100ms), not OB1 -- HMI formatting has
//no reason to compete with time-critical Tuber control logic in the
//main scan cycle.
//
//Assumed HMI DB10 layout (PROPOSAL -- reconcile against the real DB):
//  DBD 0    GlueSetpoint         REAL   written by FC105
//  DBD 4    GlueActualValue      REAL   written by FC105
//  DBX 8.0  GlueOutOfTolerance   BOOL   written by FC105
//  DBX 8.1  BannerAutoTrimFault  BOOL   written by Banner Auto-Trim interface
//  DBW 10   HMI_StatusWord       WORD   written by FC160 (this block)
//  DBW 12   HMI_Heartbeat        WORD   written by FC160 (this block)

BEGIN

NETWORK
TITLE =Heartbeat -- lets the TP177A show a "PLC alive" indicator
//Free-running counter: the HMI only needs to see it changing, not any
//particular value, so 16-bit wraparound (32767 -> -32768) is fine.
      L     DB10.DBW  12
      L     1
      +I
      T     DB10.DBW  12

NETWORK
TITLE =Pack scattered status/fault bits into one HMI status word
//Each source bit is assigned individually rather than combined with
//O/A chained directly onto a comparison result, to keep this easy to
//verify by eye and in the SIMATIC Manager compiler.
      U     DB10.DBX   8.0     //GlueOutOfTolerance (set by FC105)
      =     DB10.DBX  10.0     //HMI_StatusWord bit 0

      U     DB10.DBX   8.1     //BannerAutoTrimFault
      =     DB10.DBX  10.1     //HMI_StatusWord bit 1

//Add further bits here as more status/fault sources are confirmed
//(Glue InFeed, Glue Selection, Hot Water Supply) -- same pattern:
//      U     DB10.DBX   n.b
//      =     DB10.DBX  10.x

END_FUNCTION
